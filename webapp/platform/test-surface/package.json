{
  "name": "@mattermost/test-surface",
  "version": "0.1.0",
  "private": true,
  "description": "Static scanner that turns the webapp's data-testids into a manifest (test-surface.json) and a typed Playwright page-object SDK",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "test-surface": "./bin/test-surface.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./grammar": "./src/grammar.ts"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check": "eslint ./src ./test ./bin ./hooks --quiet",
    "fix": "eslint ./src ./test ./bin ./hooks --quiet --fix",
    "check-types": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "scan": "node --max-old-space-size=8192 ./bin/test-surface.mjs scan",
    "test:golden": "TEST_SURFACE_GOLDEN=1 node --max-old-space-size=8192 --test test/golden.test.ts"
  },
  "dependencies": {
    "js-yaml": "4.1.1",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@types/node": "24.10.4"
  }
}
